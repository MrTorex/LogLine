# By default, DO NOT touch line endings (to avoid breaking YAML inside Unity assets)
* -text

# But for code and text files, enforce LF to avoid EOL churn
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Unity meta files MUST use LF, otherwise they will constantly change
*.meta text eol=lf

# ======================================
# 3D MODELS AND ANIMATIONS
# ======================================
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
