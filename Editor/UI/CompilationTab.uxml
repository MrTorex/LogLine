<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="True">
    <ui:VisualElement class="ll-tab-root">
        <!-- Active Compilation Matrix -->
        <ui:VisualElement class="ll-card">
            <ui:Label text="Active Domain Compilation Status" class="ll-card-title" />
            <ui:Label name="compiled-summary-label" text="" class="ll-card-subtitle" />
            <ui:VisualElement name="compiled-level-strip" class="ll-level-strip" />
            <ui:Label text="Call sites below the compiled threshold (including argument evaluation) are omitted from IL via [Conditional]." class="ll-muted" />
        </ui:VisualElement>

        <!-- Threshold & Target Selection -->
        <ui:VisualElement class="ll-card">
            <ui:Label text="Configure Scripting Define Symbols" class="ll-card-title" />
            <ui:Label text="Select a compile-time threshold and target platforms. Changes are only written to PlayerSettings when you click Apply." class="ll-card-subtitle" />

            <ui:VisualElement name="threshold-field-host" class="ll-field" />

            <ui:VisualElement name="none-warning-box" class="ll-banner ll-banner--warning ll-hidden">
                <ui:Label text="LOGLINE_MIN_NONE strips all LogLine call sites (including Error and Fatal) at compile time." class="ll-banner-text" />
            </ui:VisualElement>

            <ui:Label text="Target Platforms" class="ll-card-title" style="margin-top: 10px;" />
            <ui:VisualElement name="platforms-container" />

            <ui:VisualElement class="ll-button-row">
                <ui:Button name="apply-defines-button" text="Apply Scripting Defines" />
                <ui:Button name="select-all-targets-button" text="Select All" />
                <ui:Button name="select-active-target-button" text="Active Only" />
            </ui:VisualElement>
            <ui:Label name="apply-status-label" text="" class="ll-muted" style="margin-top: 6px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
